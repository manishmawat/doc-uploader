{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "clean",
			"command": "dotnet",
			"type": "process",
			"args": [
				"clean",
				"${workspaceFolder}/frontend/UploaderDoc.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "publish-release",
			"command": "dotnet",
			"type": "process",
			"args": [
				"publish",
				"${workspaceFolder}/frontend/UploaderDoc.csproj",
				"--configuration",
				"Release",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"dependsOn": "clean"
		},
		{
			"label": "ng-serve",
			"detail": "Angular My Documents app on http://localhost:4200 (hosted by /mydocuments)",
			"type": "npm",
			"script": "start",
			"path": "ng-app",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "dev: all",
			"detail": "API, Blazor app and Angular app together (npm run dev); terminate the task to stop all three",
			"type": "npm",
			"script": "dev",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}